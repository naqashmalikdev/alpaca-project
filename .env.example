# Alpaca Trading API (paper trading) credentials.
# Generate at https://app.alpaca.markets/paper/dashboard/overview -> API Keys
ALPACA_TRADING_KEY_ID=
ALPACA_TRADING_SECRET_KEY=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# Alpaca Connect (OAuth) app credentials.
# Register at https://app.alpaca.markets/connect -> "My Developed Apps"
# (manual review by Alpaca; not instant). Redirect URI must match exactly
# what you registered there.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
ALPACA_OAUTH_SCOPE=trading account:write
ALPACA_OAUTH_ENV=paper

PORT=3000
